{
  "name": "@volcengine-tls/volclog",
  "version": "1.0.1",
  "description": "Volcengine TLS CLI with bundled Agent skill installer",
  "license": "Apache-2.0",
  "bin": {
    "volclog": "npm/bin/volclog.js"
  },
  "files": [
    "npm/bin",
    "npm/lib",
    "npm/scripts",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
