{
  "name": "@volcengine-tls/volclog",
  "version": "1.0.5-rc.3",
  "description": "Volcengine TLS CLI default agent-first edition with bundled Agent skill installer",
  "license": "Apache-2.0",
  "bin": {
    "volclog": "npm/bin/volclog.js"
  },
  "files": [
    "npm/bin",
    "npm/lib",
    "npm/scripts",
    "docs",
    "README.md",
    "README_ZH.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node npm/scripts/postinstall.js",
    "prepublishOnly": "node scripts/check-npm-rc-publish.mjs",
    "test:npm": "node --test npm/test/*.test.js",
    "pack:npm": "npm pack .",
    "pack:npm:human": "npm pack ./npm/human-package",
    "publish:npm:rc": "npm publish --registry https://registry.npmjs.org/ --tag rc --access public .",
    "publish:npm:human:rc": "npm publish --registry https://registry.npmjs.org/ --tag rc --access public ./npm/human-package"
  },
  "publishConfig": {
    "access": "public",
    "tag": "rc",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volcengine-tls/ve-tls-cli.git"
  }
}
